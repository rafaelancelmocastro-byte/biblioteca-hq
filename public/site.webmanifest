{
  "name": "Biblioteca HQ",
  "short_name": "BiblioHQ",
  "description": "O multiverso dos quadrinhos em um só lugar.",
  "start_url": "/biblioteca",
  "display": "standalone",
  "background_color": "#0f0f11",
  "theme_color": "#0f0f11",
  "orientation": "any",
  "share_target": {
    "action": "/share-pdf",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "pdfs", "accept": ["application/pdf", ".pdf", ".cbr", ".cbz", ".epub", ".azw3"] }] }
  },
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
